# ── AI model ────────────────────────────────────────────────────────────────
# openai-compatible | ollama | demo (demo requires explicit ASH_DEMO=1)
ASH_MODEL_PROVIDER=openai-compatible
ASH_MODEL_NAME=
ASH_MODEL_BASE_URL=https://api.openai.com/v1
ASH_MODEL_API_KEY=
# Optional: read the key from an owner-only file instead of the environment.
ASH_MODEL_API_KEY_FILE=
ASH_MODEL_TIMEOUT_MS=120000
ASH_MODEL_JSON_MODE=true

# ── Marketplace ─────────────────────────────────────────────────────────────
MARKET_MCP_URL=https://market.near.ai/mcp
# Bearer token from the market's OAuth consent flow. Never commit this file.
MARKET_API_TOKEN=
# Optional: read the token from an owner-only file instead of the environment.
MARKET_API_TOKEN_FILE=
# direct: hire one agent at its listed price from a private draft
# board:  post a public job and award a bid (requires a public-posting approval)
ASH_HIRING_MODE=direct
# standard: hires and acceptances are approved by you on the market page
# pro:      legacy endpoint; Ash blocks unbounded create_job/award_bid charges
ASH_MARKET_MODE=standard
ASH_ALLOW_IN_CALL_SPEND=false
ASH_MARKET_TIMEOUT_MS=60000
ASH_MARKET_MAX_RETRIES=3
ASH_MARKET_RATE_LIMIT=60

# ── Notifications (optional) ────────────────────────────────────────────────
# Create a bot with @BotFather. Both values are required to enable delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_MS=5000

# ── API, web UI and optional remote access ───────────────────────────────────
# Local web UI: http://localhost:5050. Use 0 for an ephemeral port.
ASH_SERVER_HOST=127.0.0.1
ASH_SERVER_PORT=5050
# Fixed API/web sign-in token. Required for a non-loopback host; at least 24 chars.
# Generate one with: openssl rand -base64 32
ASH_SERVER_TOKEN=
# Remote is off by default. Enable only with TLS or on a trusted private network.
ASH_SERVER_ALLOW_REMOTE=false
# Public origin for links behind a proxy, e.g. https://ash.example.com (no path).
ASH_SERVER_PUBLIC_URL=
# auto = Secure cookies on HTTPS requests; always = require TLS termination.
ASH_SERVER_SECURE_COOKIES=auto
# Start browser access after a restart. OFF by default; B / ash frontend on enables it.
ASH_SERVER_UI=false

# ── Application ─────────────────────────────────────────────────────────────
ASH_DATA_DIR=.ash-data
# Optional alternate env file location; shell values still win.
ASH_ENV_FILE=
ASH_LOG_LEVEL=INFO
ASH_COLOR_MODE=auto
ASH_UNICODE_MODE=auto
ASH_ANIMATION=true
ASH_MAX_PARALLEL_JOBS=3
ASH_MAX_RETRIES=3
ASH_MAX_AGENT_CANDIDATES=6
ASH_APPROVAL_TTL_MINUTES=30
ASH_CONTINGENCY_RATIO=0.10
ASH_MAX_DELIVERABLE_MB=10
ASH_VERIFY_COMMANDS=
ASH_SIMULATE=false
# Set to 1 to suppress the startup animation.
ASH_NO_SPLASH=

# Public TLS origin and bind host aliases (canonical settings above also work).
ASH_PUBLIC_URL=
ASH_BIND_HOST=
ASH_CODE_TTL_MINUTES=5
# UNSAFE: permits public plain HTTP only for a deliberately isolated test network.
ASH_ALLOW_INSECURE_PUBLIC_HTTP=false
# Explicit demo opt-in; refused with NODE_ENV=production. Prefer npm run demo.
ASH_DEMO=0
