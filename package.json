{
  "name": "ash",
  "version": "1.1.0",
  "private": true,
  "description": "Ash — task execution and settlement system for the NEAR AI Agent Market",
  "type": "module",
  "bin": {
    "ash": "./dist/index.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "npm run build:server && npm run build:web && node scripts/build-tui.mjs",
    "build:server": "node scripts/build-server.mjs",
    "build:tui": "node scripts/build-tui.mjs --required",
    "start": "node scripts/ash.mjs start",
    "typecheck": "tsc -p tsconfig.tests.json",
    "test": "tsx --test --test-concurrency=2 tests/*.test.ts",
    "test:tui": "node scripts/build-tui.mjs --test",
    "check": "npm run typecheck && npm test",
    "build:web": "node scripts/build-web.mjs",
    "test:remote-tls": "tsx --test tests/tls-proxy.integration.ts",
    "demo": "node scripts/ash.mjs demo",
    "tui": "node scripts/ash.mjs tui",
    "cli": "node scripts/ash.mjs",
    "doctor": "node scripts/ash.mjs doctor",
    "status": "node scripts/ash.mjs status",
    "verify": "node scripts/ash.mjs tracks verify",
    "export": "node scripts/ash.mjs export",
    "logs": "node scripts/ash.mjs logs",
    "server:start": "node scripts/ash.mjs server start",
    "server:stop": "node scripts/ash.mjs server stop",
    "server:status": "node scripts/ash.mjs server status",
    "test:all": "npm run check && npm run test:tui && npm run test:remote-tls",
    "web": "node scripts/ash.mjs web --open",
    "web:serve": "node scripts/ash.mjs web",
    "test:web": "node --import tsx scripts/test-web.mjs",
    "test:web:tracks": "node --import tsx scripts/test-tracks-web.mjs",
    "web:stop": "node scripts/ash.mjs web --stop",
    "web:dev": "vite --config frontend/vite.config.js",
    "demo:journey": "node scripts/ash.mjs tracks run all",
    "verify:tracks": "node scripts/ash.mjs tracks verify",
    "verify:receipts": "node scripts/ash.mjs verify",
    "lint": "eslint src tests frontend scripts web",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"frontend/**/*.{js,jsx,css}\" \"web/*.{js,css,html}\" \"scripts/*.mjs\" \"*.{json,yaml}\" \"eslint.config.js\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"frontend/**/*.{js,jsx,css}\" \"web/*.{js,css,html}\" \"scripts/*.mjs\" \"*.{json,yaml}\" \"eslint.config.js\"",
    "test:access": "tsx --test tests/frontend-access.test.ts tests/remote.test.ts tests/health.test.ts",
    "test:demo": "tsx --test tests/demo.test.ts",
    "security": "npm audit --registry=https://registry.npmjs.org --audit-level=moderate",
    "validate:deploy": "node scripts/validate-deploy.mjs",
    "test:production": "node scripts/test-production.mjs",
    "test:deployments": "node scripts/test-deployments.mjs",
    "test:container": "node scripts/test-deployments.mjs --docker"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@react-three/fiber": "^9.8.2",
    "framer-motion": "^14.9.0",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.0",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "js-yaml": "^4.3.2",
    "postcss": "^8.5.6",
    "prettier": "^3.9.10",
    "rollup": "npm:@rollup/wasm-node@4.67.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.5"
  },
  "overrides": {
    "rollup": "$rollup",
    "minimatch": "^11.0.1"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/festac-dev/Ash-ai.git"
  },
  "homepage": "https://github.com/festac-dev/Ash-ai",
  "bugs": {
    "url": "https://github.com/festac-dev/Ash-ai/issues"
  }
}
