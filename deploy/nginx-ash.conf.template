# Include the rendered server block inside nginx's http block.
# Ash must listen only on 127.0.0.1 at ASH_UPSTREAM_PORT.
server {
    listen ${ASH_TLS_PORT} ssl;
    server_name ${ASH_PUBLIC_HOST};
    ssl_certificate ${ASH_TLS_CERT};
    ssl_certificate_key ${ASH_TLS_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://127.0.0.1:${ASH_UPSTREAM_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
    location ~ ^/api/(frontend|auth/ticket) { return 403; }
}
