# Put inside nginx's http context. Replace the domain and certificate paths.
server {
    listen 80;
    server_name ash.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name ash.example.com;
    ssl_certificate /etc/letsencrypt/live/ash.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ash.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 1m;
    location / {
        proxy_pass http://127.0.0.1:5050;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 1h;
    }
    # Codes can only be issued in the trusted host terminal.
    location ~ ^/api/(frontend|auth/ticket) { return 403; }
}
